<?xml version="1.0" encoding="utf-8"?>
<!--
  Cleartext is permitted only for the addresses a local development stack lives
  on: 10.0.2.2 is the host as seen from the Android emulator. These are not
  routable anywhere else, so allowing them costs nothing in a release build,
  while a blanket usesCleartextTraffic would.
-->
<network-security-config>
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">10.0.2.2</domain>
        <domain includeSubdomains="false">127.0.0.1</domain>
        <domain includeSubdomains="false">localhost</domain>
    </domain-config>
</network-security-config>

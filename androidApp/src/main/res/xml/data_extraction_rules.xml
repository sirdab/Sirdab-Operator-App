<!-- The Android 12+ form of backup_rules.xml; see the note there. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="file" path="outbox" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="file" path="outbox" />
    </device-transfer>
</data-extraction-rules>

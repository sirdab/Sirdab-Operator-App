# Copy to keystore.properties (gitignored) to sign release builds with the Play upload key.
# Paths are relative to the project root. Keep the keystore itself out of the repository too,
# and back it up with its passwords somewhere safe: Play App Signing can reset a lost upload
# key, but only through a support request.
storeFile=keys/sirdab-driver-upload.jks
storePassword=
keyAlias=upload
keyPassword=
